generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Exam {
  id          String     @id @default(uuid())
  title       String
  year        Int
  course      String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  questions   Question[]

  @@map("exams")
}

model Question {
  id            String        @id @default(uuid())
  examId        String?
  number        Int
  area          String
  difficulty    String        @default("medium") // easy, medium, hard
  contextText   String        // Texto-base / contextualização
  supportText   String?       // Código de apoio, citação ou dados adicionais
  prompt        String        // Comando da questão
  correctLetter String        // 'A', 'B', 'C', 'D' ou 'E'
  explanation   String        // Resolução comentada e gabarito
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  exam          Exam?         @relation(fields: [examId], references: [id], onDelete: Cascade)
  alternatives  Alternative[]

  @@map("questions")
}

model Alternative {
  id         String   @id @default(uuid())
  questionId String
  letter     String   // 'A', 'B', 'C', 'D', 'E'
  text       String
  createdAt  DateTime @default(now())

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, letter])
  @@map("alternatives")
}
